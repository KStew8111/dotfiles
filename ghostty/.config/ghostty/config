# Ghostty configuration
# https://ghostty.org/docs/config

maximize = true

# Typography
font-family = "CaskaydiaMono Nerd Font"
font-size = 10
font-feature = "liga"

# Window Layout
window-padding-x = 12
window-padding-y = 12
window-decoration = false

# Cursor
cursor-style = block
cursor-style-blink = true

copy-on-select = true

# --- Colors ---
# Generated by rig-theme-apply; the file lives outside the stowed dotfiles
# tree so theme switches do not dirty this repo. `?` makes it optional.
config-file = ?~/.local/state/rig/theme/ghostty.conf

# --- Style ---
background-opacity = 0.8
background-blur-radius = 20

# --- Shell ---
shell-integration-features = ssh-terminfo
mouse-scroll-multiplier = 1
